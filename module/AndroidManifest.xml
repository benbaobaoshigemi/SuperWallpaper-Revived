<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.miui.superwallpapernoaod"
    android:versionCode="9"
    android:versionName="1.5.0">
    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:label="SuperWallpaper Revived">
        <activity
            android:name=".ComposeSettingsActivity"
            android:exported="true"
            android:label="SuperWallpaper Revived"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".ModuleSettingsProvider"
            android:authorities="com.miui.superwallpapernoaod.settings"
            android:exported="true"
            android:grantUriPermissions="false" />
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposeddescription"
            android:value="禁止超级壁纸接管AOD：保持主题/息屏AOD不变，锁屏与桌面动效不受影响" />
        <meta-data android:name="xposedminversion" android:value="82" />
        <meta-data android:name="xposedscope" android:resource="@array/xposedscope" />
    </application>
</manifest>
